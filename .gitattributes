# /.build is already gitignored, so it is not normally tracked and would not
# reach an archive regardless of this line (a forced `git add -f` could still
# track it) — kept anyway, matching the template, as a defensive backstop.
/.build             export-ignore
# Export-ignoring /.github blinds OSSF Scorecard's file-based checks
# (Dangerous-Workflow, Token-Permissions, Pinned-Dependencies report `-1` = "not
# applicable", not a penalty) — Scorecard analyses the export-ignored tarball.
# Accepted: those are covered on the real checkout by zizmor + CodeQL `actions`.
/.github            export-ignore
/.phplint.yml       export-ignore
/phpstan.neon       export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/tests              export-ignore
/AGENTS.md          export-ignore
/phpunit.xml.dist   export-ignore
