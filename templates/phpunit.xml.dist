<?xml version="1.0" encoding="UTF-8"?>
<!--
    Shared PHPUnit template for magicsunday/* projects. Copy to phpunit.xml
    (or phpunit.xml.dist) in the consumer and adjust bootstrap, cache path,
    testsuite directories and the <source> include to the repo layout.

    The strictness flags are the house standard: every one of them should stay
    on. The failOn* set turns any risky test, warning, notice or deprecation
    into a red build.

    requireCoverageMetadata and beStrictAboutCoverageMetadata are deliberately
    not part of the set. They only police how a test declares its target
    (#[CoversClass]/#[UsesClass]) and say nothing about whether a test is
    worth having. A repository that keeps a hard coverage percentage may add
    them, because accidental coverage would otherwise inflate the figure. The
    consumer check accepts them on or off.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".build/cache/.phpunit.cache"
         beStrictAboutOutputDuringTests="true"
         failOnRisky="true"
         failOnWarning="true"
         failOnNotice="true"
         failOnDeprecation="true"
         failOnPhpunitDeprecation="true"
         failOnPhpunitNotice="true"
         displayDetailsOnPhpunitDeprecations="true"
         executionOrder="defects"
         columns="max">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests</directory>
            <!-- tests/Architecture holds rule classes (PHPStan or otherwise),
                 never a PHPUnit test — exclude it unconditionally so PHPUnit
                 does not warn on a non-TestCase. -->
            <exclude>tests/Architecture</exclude>
        </testsuite>
    </testsuites>

    <source restrictNotices="true"
            restrictWarnings="true"
            ignoreIndirectDeprecations="true">
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
