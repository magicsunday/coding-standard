# CI fixture: includes the shared STRICT tier exactly as a consumer does, scoped to
# the `symplify-modern/` fixture directory (a trait and a by-reference parameter).
# This run is EXPECTED TO FAIL — `tests/CheckSymplifyModernRulesTest.php` asserts that
# the strict tier reports both, which proves it switches on symplify's `modern` rule
# group (`symplify.forbiddenTrait`, `symplify.noReference`).
includes:
    - .build/vendor/magicsunday/coding-standard/phpstan/strict.neon

parameters:
    phpVersion:
        min: 80300
        max: 80500

    paths:
        - symplify-modern
