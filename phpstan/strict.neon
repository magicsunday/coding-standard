# Opt-in strict PHPStan tier for magicsunday/* projects.
#
# Adds the shipmonk/symplify rule packs, the case-folding bans from
# disallowed-calls.neon, and the extra-strict report parameters on top of
# base.neon. Checked-exceptions enforcement (see README's "Checked exceptions"
# section) moved to base.neon by GH-144 — every consumer of this package gets
# it now, not only the strict tier. Requires the consumer to install all three
# packs:
#
#     composer require --dev shipmonk/phpstan-rules symplify/phpstan-rules spaze/phpstan-disallowed-calls
#
# Adopt via the `adopt-strict-phpstan-ruleset` workflow, triaging each finding.
#
# Consumer phpstan.neon:
#
#     includes:
#         - .build/vendor/magicsunday/coding-standard/phpstan/strict.neon
includes:
    - base.neon
    - disallowed-calls.neon
    - ../../../shipmonk/phpstan-rules/rules.neon
    - ../../../symplify/phpstan-rules/config/services/services.neon
    - ../../../symplify/phpstan-rules/config/code-complexity-rules.neon
    - ../../../symplify/phpstan-rules/config/configurable-rules.neon
    - ../../../symplify/phpstan-rules/config/modern-rules.neon
    - ../../../symplify/phpstan-rules/config/naming-rules.neon
    - ../../../symplify/phpstan-rules/config/static-rules.neon
    - ../../../symplify/phpstan-rules/config/symfony-config-rules.neon

parameters:
    # Extra-strict report parameters.
    checkImplicitMixed: true
    checkBenevolentUnionTypes: true
    checkUninitializedProperties: true
    checkMissingCallableSignature: true
    checkTooWideReturnTypesInProtectedAndPublicMethods: true
    reportAnyTypeWideningInVarTag: true
    reportPossiblyNonexistentConstantArrayOffset: true
    reportPossiblyNonexistentGeneralArrayOffset: true

    # symplify/phpstan-rules 14.16+ switches each rule file included above on
    # through a %symplify.<set>% parameter that only its own
    # config/phpstan-extensions.neon declares. The switches are declared here
    # instead of including that file, one per included rule file, with a
    # permissive schema that tolerates a consumer loading symplify's own file as
    # well (see the README). Without them every 14.16+ install fails to load with
    # "Missing parameter 'symplify.complexity'". modern-rules.neon first exists
    # in 14.19, which is why the floor of the strict tier is 14.19. Below it that
    # include does not resolve.
    symplify:
        naming: true
        complexity: true
        configurable: true
        static: true
        modern: true
        symfonyConfig: true

parametersSchema:
    # A map of booleans rather than symplify's own structure(): whichever of
    # the two schemas loads last replaces the other, and a fixed key list
    # here would reject the keys symplify's own file sets when a consumer
    # also loads it (phpstan/extension-installer does). Before 14.16 no
    # schema exists at all, and an undeclared parameter is a load error.
    symplify: arrayOf(bool())
