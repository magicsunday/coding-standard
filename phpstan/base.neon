# Shared PHPStan base configuration for magicsunday/* projects.
#
# The rule extensions are included explicitly by paths relative to THIS file, so
# the config is valid in every context that loads it — the main PHPStan run and
# Rector's phpstanConfig alike, which extension-installer does NOT cover. The
# relative `../../../<vendor-package>` paths resolve regardless of the consumer's
# vendor-dir (`vendor` or `.build/vendor`).
#
# Consumer phpstan.neon:
#
#     includes:
#         - .build/vendor/magicsunday/coding-standard/phpstan/base.neon
#     parameters:
#         # A range for a multi-version repository (min = floor, max = ceiling);
#         # a single-PHP repository uses the scalar `phpVersion: 80300`.
#         phpVersion:
#             min: 80300
#             max: 80500
#         paths:
#             - src
#             - tests
includes:
    - ../../../phpstan/phpstan-strict-rules/rules.neon
    - ../../../phpstan/phpstan-deprecation-rules/rules.neon
    - ../../../phpstan/phpstan-phpunit/extension.neon
    - ../../../phpstan/phpstan-phpunit/rules.neon

parameters:
    # 0 is the loosest, 10 (max) the strictest.
    level: max

    # Distrust PHPDoc types the engine cannot prove. Without this, a wrong or
    # widened @var/@param silently becomes the analysed truth and hides the very
    # mismatch it should surface.
    treatPhpDocTypesAsCertain: false

    fileExtensions:
        - php

    # Checked exceptions (GH-139, promoted here from the opt-in strict tier by
    # GH-144 once webtrees-statistics — the one real strict-tier consumer at the
    # time — was verified green against it): a throwing method documents it in
    # @throws, and @throws names only what the body can actually raise. Full
    # diagnostic-identifier/default-value writeup — including why
    # exceptions.check.tooWideThrowType is deliberately NOT set below (it is
    # already PHPStan's own default; setting it here would be a no-op that reads
    # as if this config newly enables it) and the
    # checkTooWideThrowTypesInProtectedAndPublicMethods non-final-first-
    # declaration gap — lives in README.md's "Checked exceptions" section, not
    # duplicated here.
    #
    # Verified 2026-09-03 against phpstan/phpstan 2.2.12 — re-verify against the
    # pins actually installed if a claim there stops holding after a version
    # bump.
    checkTooWideThrowTypesInProtectedAndPublicMethods: true
    exceptions:
        check:
            missingCheckedExceptionInThrows: true
        checkedExceptionRegexes:
            - '#^MagicSunday\\#'
        uncheckedExceptionClasses:
            - 'LogicException'
