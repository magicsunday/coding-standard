{
    "name": "@magicsunday/coding-standard",
    "version": "1.8.0",
    "description": "Shared Biome and TypeScript configuration for the magicsunday/* JS/TS projects.",
    "license": "MIT",
    "author": "Rico Sonntag <mail@ricosonntag.de>",
    "homepage": "https://github.com/magicsunday/coding-standard",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/magicsunday/coding-standard.git"
    },
    "keywords": [
        "biome",
        "tsconfig",
        "coding-standard"
    ],
    "files": [
        "biome",
        "tsconfig",
        "bin/check-js-config.mjs",
        "bin/support/safe-report-value.mjs",
        "bin/support/merge-config-layer.mjs",
        "bin/support/bounded-reader.mjs",
        "bin/support/jsonc.mjs"
    ],
    "bin": {
        "check-js-config": "bin/check-js-config.mjs"
    },
    "engines": {
        "node": ">=20"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=24",
            "onFail": "error"
        }
    },
    "scripts": {
        "ci:test:js": "bash tests/check-js-configs.sh && node --test tests/*.test.mjs"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.10",
        "jscpd": "5.0.16",
        "typescript": "7.0.2"
    },
    "peerDependencies": {
        "@biomejs/biome": "^2.5.0",
        "typescript": "^7.0.2"
    },
    "peerDependenciesMeta": {
        "@biomejs/biome": {
            "optional": true
        },
        "typescript": {
            "optional": true
        }
    }
}
