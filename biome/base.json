{
    "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100,
        "lineEnding": "lf"
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double",
            "semicolons": "always",
            "trailingCommas": "all",
            "bracketSpacing": true
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "style": {
                "useTemplate": "error",
                "useDefaultParameterLast": "error",
                "useConst": "warn",
                "noParameterAssign": "warn",
                "noNegationElse": "warn"
            },
            "suspicious": {
                "noDoubleEquals": "error",
                "noPrototypeBuiltins": "error",
                "noShadowRestrictedNames": "error",
                "useIsArray": "error"
            },
            "correctness": {
                "useImportExtensions": {
                    "level": "error",
                    "options": {
                        "extensionMappings": {
                            "ts": "js",
                            "tsx": "js",
                            "mts": "mjs",
                            "cts": "cjs"
                        }
                    }
                },
                "noUnusedVariables": "warn",
                "noUnusedImports": "warn",
                "noUnusedFunctionParameters": "warn"
            },
            "complexity": {
                "noExcessiveCognitiveComplexity": {
                    "level": "warn",
                    "options": {
                        "maxAllowedComplexity": 25
                    }
                },
                "useArrowFunction": "error"
            },
            "performance": {
                "noDelete": "warn"
            },
            "security": {
                "noDangerouslySetInnerHtml": "error"
            }
        }
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    }
}
